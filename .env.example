# Public Supabase client config for Vite/browser builds.
# Never add Postgres passwords, JWT secret, service_role key, or sb_secret keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Optional aliases used by Vercel's Supabase integration.
GD_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
GD_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Optional resource-prefixed aliases if Vercel exports them this way.
GAMEDEALBD_GD_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
GAMEDEALBD_GD_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
